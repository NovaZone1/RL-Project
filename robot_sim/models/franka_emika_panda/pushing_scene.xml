<mujoco model="panda pushing scene">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_material" rgba="0.45 0.30 0.20 1"/>
    <material name="cube_material" rgba="0.95 0.25 0.10 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="table" pos="0.55 0 0.20">
      <geom name="table_top" type="box" size="0.40 0.50 0.20" material="table_material" friction="1 0.005 0.0001"/>
    </body>
    <body name="cube" pos="0.55 -0.05 0.435">
      <freejoint/>
      <geom name="cube_geom" type="box" size="0.035 0.035 0.035" mass="0.10"
        material="cube_material" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="pushing_home"
      qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04 0.55 -0.05 0.435 1 0 0 0"
      ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
